{
  "name": "thunder-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "user": "node --env-file=.env.local scripts/user.ts",
    "import:teamsnap": "tsx --env-file=.env.local scripts/import-teamsnap.ts",
    "import:teams": "tsx --env-file=.env.local scripts/import-teams.ts",
    "import:practice": "tsx --env-file=.env.local scripts/import-practice.ts",
    "import:evaluations": "tsx --env-file=.env.local scripts/import-evaluations.ts",
    "email:test": "tsx --conditions=react-server --env-file=.env.local scripts/test-email.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
